{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/prepare-vercel.mjs",
  "outputDirectory": "dist",
  "installCommand": "echo 'no npm install required'",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": true,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "includeFiles": "{agents/**,api/_bundle/**,api/lib/**}"
    }
  },
  "crons": [
    {
      "path": "/api/ceo/cycle",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/agent-autonomous",
      "schedule": "0 15 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "rewrites": [
    { "source": "/privacy", "destination": "/legal/privacy/" },
    { "source": "/privacy/", "destination": "/legal/privacy/" }
  ]
}
