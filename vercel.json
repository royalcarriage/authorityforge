{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/prepare-vercel.mjs",
  "outputDirectory": "dist",
  "installCommand": "echo 'no npm install required'",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": true,
  "crons": [
    {
      "path": "/api/ceo/cycle",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/agent-autonomous",
      "schedule": "0 15 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
