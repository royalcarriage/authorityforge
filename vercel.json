{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/prepare-vercel.mjs",
  "outputDirectory": "dist",
  "installCommand": "echo 'no npm install required'",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": true,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "includeFiles": "{agents/**,content/queue.json,js/config.js,api/lib/**}"
    }
  },
  "crons": [
    {
      "path": "/api/ceo/cycle",
      "schedule": "0 14 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/legal/privacy/"
    },
    {
      "source": "/privacy/",
      "destination": "/legal/privacy/"
    }
  ]
}
